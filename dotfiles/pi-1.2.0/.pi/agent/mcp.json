{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
      "description": "Search the public web and read web pages; anonymous access with rate limits"
    },
    "openaiDeveloperDocs": {
      "url": "https://developers.openai.com/mcp",
      "description": "Official OpenAI and Codex documentation"
    },
    "agent-memory": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/mcp-agent-memory\" \"$@\"",
        "agent-memory"
      ]
    },
    "nixos": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/mcp-nixos\" \"$@\"",
        "nixos"
      ]
    },
    "chrome-devtools": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/mcp-chrome-devtools\" \"$@\"",
        "chrome-devtools"
      ]
    },
    "playwright": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/mcp-playwright\" \"$@\"",
        "playwright"
      ]
    },
    "dbhub": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/mcp-dbhub\" \"$@\"",
        "dbhub"
      ]
    }
  }
}
