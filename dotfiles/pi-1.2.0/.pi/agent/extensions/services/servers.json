{
  "qartez": {
    "command": "~/.local/bin/qartez",
    "description": "Indexed code navigation, source lookup and impact analysis"
  },
  "agent-memory": {
    "command": "agent-memory",
    "args": [
      "mcp"
    ],
    "description": "Shared durable project memory"
  },
  "headroom": {
    "command": "headroom",
    "args": [
      "mcp",
      "serve",
      "--transport",
      "stdio"
    ],
    "description": "Compress large tool outputs and retrieve original evidence"
  },
  "blender": {
    "command": "blender-mcp",
    "args": [
      "--transport",
      "stdio"
    ],
    "env": {
      "BLENDER_MCP_HOST": "127.0.0.1",
      "BLENDER_MCP_PORT": "9876"
    },
    "description": "Inspect and edit the local Blender scene"
  },
  "openaiDeveloperDocs": {
    "url": "https://developers.openai.com/mcp",
    "description": "Official OpenAI and Codex documentation"
  }
}
