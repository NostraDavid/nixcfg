{
  "$schema": "https://opencode.ai/config.json",

  // Keep updates visible without force-applying them automatically.
  "autoupdate": false,
  "share": "manual",
  "snapshot": true,
  "subagent_depth": 1,
  "shell": "bash",

  // Mirror the current default from the Pi agent profile.
  "model": "deepseek/deepseek-v4-flash",

  // Reuse the same instruction corpus used across other local agents.
  "instructions": [
    "~/AGENTS.md",
  ],

  // OpenCode v1.1.1+ uses permission instead of legacy tools booleans.
  "permission": {
    "*": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git commit *": "ask",
      "git rebase *": "ask",
      "git merge *": "ask",
      "git cherry-pick *": "ask",
      "git revert *": "ask",
      "git push *": "deny",
      "git push --force *": "deny",
      "git push --force-with-lease *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "git clean -fdx *": "deny",
      "git checkout -- *": "deny",
      "git restore --source=* *": "deny",
      "git branch -D *": "deny",
      "git tag -d *": "deny",
      "git submodule foreach *": "deny",
      "rg *": "allow",
      "fd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "sed *": "allow",
      "just *": "allow",
      "rm -rf *": "deny"
    }
  },

  // Match the MCP stack you already inject for other coding agents.
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "headroom",
        "mcp",
        "serve"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "opencode"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "engram": {
      "type": "local",
      "command": [
        "engram",
        "mcp"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
