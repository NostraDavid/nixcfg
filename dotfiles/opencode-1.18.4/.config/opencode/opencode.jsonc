{
  "$schema": "https://opencode.ai/config.json",

  // Keep updates visible without force-applying them automatically.
  "autoupdate": false,
  "share": "manual",
  "snapshot": true,
  "subagent_depth": 1,
  "shell": "bash",

  // Mirror the current default from the Pi agent profile.
  "model": "deepseek/deepseek-v4-flash",

  // TensorX provider config: https://docs.tensorx.ai/ai-coding-assistants/opencode
  "provider": {
    "tensorx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TensorX",
      "options": {
        "baseURL": "https://api.tensorx.ai/v1"
      },
      "models": {
        "z-ai/glm-5.1": {
          "name": "GLM 5.1",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "moonshotai/kimi-k2.5": {
          "name": "Kimi K2.5",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "deepseek/deepseek-r1-0528": {
          "name": "DeepSeek R1",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "qwen/qwen3-vl-235b-a22b-instruct": {
          "name": "Qwen 3 VL",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "minimax/minimax-m2": {
          "name": "MiniMax M2",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "z-ai/glm-5.2": {
          "name": "GLM 5.2",
          "limit": {
            "context": 1048576,
            "output": 16384
          }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1048576,
            "output": 16384
          }
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },

  // Reuse the same instruction corpus used across other local agents.
  "instructions": [
    "~/AGENTS.md",
  ],

  // OpenCode v1.1.1+ uses permission instead of legacy tools booleans.
  "permission": {
    "*": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git commit *": "ask",
      "git rebase *": "ask",
      "git merge *": "ask",
      "git cherry-pick *": "ask",
      "git revert *": "ask",
      "git push *": "deny",
      "git push --force *": "deny",
      "git push --force-with-lease *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "git clean -fdx *": "deny",
      "git checkout -- *": "deny",
      "git restore --source=* *": "deny",
      "git branch -D *": "deny",
      "git tag -d *": "deny",
      "git submodule foreach *": "deny",
      "rg *": "allow",
      "fd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "sed *": "allow",
      "just *": "allow",
      "rm -rf *": "deny"
    }
  },

  // Match the MCP stack you already inject for other coding agents.
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "headroom",
        "mcp",
        "serve"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "codex"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "qartez": {
      "type": "local",
      "command": [
        "qartez"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "engram": {
      "type": "local",
      "command": [
        "engram",
        "mcp"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
