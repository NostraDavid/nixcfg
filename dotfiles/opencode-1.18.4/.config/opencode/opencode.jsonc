{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": [
    "~/AGENTS.md"
  ],
  "mcp": {
    "engram": {
      "command": [
        "engram",
        "mcp"
      ],
      "enabled": true,
      "timeout": 30000,
      "type": "local"
    },
    "headroom": {
      "command": [
        "headroom",
        "mcp",
        "serve"
      ],
      "enabled": true,
      "timeout": 30000,
      "type": "local"
    },
    "qartez": {
      "command": [
        "/home/david/.local/bin/qartez"
      ],
      "enabled": true,
      "type": "local"
    },
    "serena": {
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "codex"
      ],
      "enabled": true,
      "timeout": 30000,
      "type": "local"
    }
  },
  "model": "deepseek/deepseek-v4-flash",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "fd *": "allow",
      "git *": "allow",
      "git branch -D *": "deny",
      "git checkout -- *": "deny",
      "git cherry-pick *": "ask",
      "git clean -fd *": "deny",
      "git clean -fdx *": "deny",
      "git commit *": "ask",
      "git merge *": "ask",
      "git push *": "deny",
      "git push --force *": "deny",
      "git push --force-with-lease *": "deny",
      "git rebase *": "ask",
      "git reset --hard *": "deny",
      "git restore --source=* *": "deny",
      "git revert *": "ask",
      "git submodule foreach *": "deny",
      "git tag -d *": "deny",
      "just *": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "rm -rf *": "deny",
      "sed *": "allow"
    },
    "doom_loop": "ask",
    "external_directory": "ask"
  },
  "provider": {
    "tensorx": {
      "models": {
        "deepseek/deepseek-r1-0528": {
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "name": "DeepSeek R1"
        },
        "deepseek/deepseek-v4-flash": {
          "limit": {
            "context": 1048576,
            "output": 16384
          },
          "name": "DeepSeek V4 Flash"
        },
        "minimax/minimax-m2": {
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "name": "MiniMax M2"
        },
        "moonshotai/kimi-k2.5": {
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "name": "Kimi K2.5"
        },
        "openai/gpt-oss-120b": {
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "name": "GPT-OSS 120B"
        },
        "qwen/qwen3-vl-235b-a22b-instruct": {
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Qwen 3 VL"
        },
        "z-ai/glm-5.1": {
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "name": "GLM 5.1"
        },
        "z-ai/glm-5.2": {
          "limit": {
            "context": 1048576,
            "output": 16384
          },
          "name": "GLM 5.2"
        }
      },
      "name": "TensorX",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.tensorx.ai/v1"
      }
    }
  },
  "share": "manual",
  "shell": "bash",
  "snapshot": true,
  "subagent_depth": 1
}
