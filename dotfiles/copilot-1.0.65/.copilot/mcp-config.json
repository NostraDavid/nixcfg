{
  "mcpServers": {
    "agent-memory": {
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/agent-memory\" \"$@\"",
        "agent-memory",
        "mcp"
      ],
      "command": "/bin/sh",
      "tools": [
        "*"
      ],
      "type": "local"
    },
    "qartez": {
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/qartez\" \"$@\"",
        "qartez"
      ],
      "command": "/bin/sh",
      "tools": [
        "*"
      ],
      "type": "local"
    },
    "headroom": {
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/headroom\" \"$@\"",
        "headroom",
        "mcp",
        "serve",
        "--transport",
        "stdio"
      ],
      "command": "/bin/sh",
      "tools": [
        "*"
      ],
      "type": "local"
    }
  }
}
