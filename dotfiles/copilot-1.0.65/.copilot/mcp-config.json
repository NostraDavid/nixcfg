{
  "mcpServers": {
    "agent-memory": {
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/mcp-agent-memory\" \"$@\"",
        "agent-memory"
      ],
      "command": "/bin/sh",
      "tools": [
        "*"
      ],
      "type": "local"
    },
    "qartez": {
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/mcp-qartez\" \"$@\"",
        "qartez"
      ],
      "command": "/bin/sh",
      "tools": [
        "*"
      ],
      "type": "local"
    },
    "headroom": {
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/mcp-headroom\" \"$@\"",
        "headroom"
      ],
      "command": "/bin/sh",
      "tools": [
        "*"
      ],
      "type": "local"
    }
  }
}
