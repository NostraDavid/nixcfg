{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "qartez-guard",
            "timeout": 3000,
            "type": "command"
          }
        ],
        "matcher": "Glob|Grep"
      },
      {
        "hooks": [
          {
            "command": "qartez-guard",
            "timeout": 3000,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "qartez-setup --session-start",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "qartez": {
      "args": [],
      "command": "qartez"
    },
    "headroom": {
      "command": "headroom",
      "args": [
        "mcp",
        "serve",
        "--transport",
        "stdio"
      ]
    }
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Grep",
      "Glob"
    ]
  }
}
