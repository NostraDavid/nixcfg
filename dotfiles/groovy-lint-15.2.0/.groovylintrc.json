{
  "extends": "recommended-jenkinsfile",
  "rules": {
    "CompileStatic": {
      "enabled": false
    },
    "MethodReturnTypeRequired": "off",
    "NoDef": "off",
    "dry.DuplicateStringLiteral": {
      "duplicateStringMinimumLength": 8,
      "severity": "info"
    },
    "formatting.Indentation": {
      "severity": "info",
      "spacesPerIndentLevel": 4
    },
    "formatting.LineLength": "off",
    "size.NestedBlockDepth": "off"
  }
}
