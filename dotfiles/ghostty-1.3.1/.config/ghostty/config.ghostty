# Start Zellij with the Home Manager login environment.
command = bash -lc 'exec zellij'
confirm-close-surface = false

# font-family = Spleen
# font-size = 7

font-family = Iosevka Nerd Font
font-size = 14

background = #000000
foreground = #ffffff
cursor-color = #ffffff
cursor-text = #ff00ff
selection-background = #ffffff
selection-foreground = #000000

palette = 0=#000000
palette = 1=#fe0100
palette = 2=#33ff00
palette = 3=#feff00
palette = 4=#0066ff
palette = 5=#cc00ff
palette = 6=#00ffff
palette = 7=#d0d0d0
palette = 8=#808080
palette = 9=#fe0100
palette = 10=#33ff00
palette = 11=#feff00
palette = 12=#0066ff
palette = 13=#cc00ff
palette = 14=#00ffff
palette = 15=#ffffff

background-opacity = 1.0
window-padding-x = 0
window-padding-y = 0

# Use epoll for async backend to avoid high CPU usage on Linux.
async-backend = epoll
