# Keep Ghostty aligned with the existing terminal setup.
command = tmux-login-session

# font-family = JetBrainsMono Nerd Font
# font-family = Creep
# font-family = ANAKRON
# font-family = ANAKRON2x
# font-family = ANAKRON3x
# font-family = Cozette
# font-family = GohuFont uni11 Nerd Font
# font-family = Kirsch Nerd Font
# font-family = ProFont IIx Nerd Font
# font-family = ProggyClean Nerd Font
# font-family = Spleen
# font-family = Spleen 12x24
# font-family = Spleen 16x32
# font-family = Spleen 32x64
# font-family = Spleen 6x12
# font-family = Spleen 8x16
# font-family = Tamzen
# font-family = Terminess Nerd Font
# font-family = kirsch
# font-family = kirsch2x
# font-family = kirsch3x
font-family = scientifica
font-size = 12

background = #000000
foreground = #ffffff
cursor-color = #ffffff
cursor-text = #ff00ff
selection-background = #ffffff
selection-foreground = #000000

palette = 0=#000000
palette = 1=#fe0100
palette = 2=#33ff00
palette = 3=#feff00
palette = 4=#0066ff
palette = 5=#cc00ff
palette = 6=#00ffff
palette = 7=#d0d0d0
palette = 8=#808080
palette = 9=#fe0100
palette = 10=#33ff00
palette = 11=#feff00
palette = 12=#0066ff
palette = 13=#cc00ff
palette = 14=#00ffff
palette = 15=#ffffff

background-opacity = 1.0
window-padding-x = 0
window-padding-y = 0
