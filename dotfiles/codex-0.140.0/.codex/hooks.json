{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "lean-ctx hook observe",
            "timeout": 4,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|StrReplace|str_replace_editor|edit_file|str_replace|replace_in_file|create_file|write_file"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "lean-ctx hook codex-pretooluse",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash|Read|Grep|Glob"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "lean-ctx hook observe",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "lean-ctx hook codex-session-start",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "lean-ctx hook observe",
            "timeout": 4,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  }
}
