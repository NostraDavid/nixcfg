{
  "inputs": [
    {
      "description": "Path to the memory storage file",
      "id": "memory_file_path",
      "password": false,
      "type": "promptString"
    },
    {
      "description": "Path to the DuckDB database file (e.g., /path/to/database.duckdb)",
      "id": "duckdb_db_path",
      "password": false,
      "type": "promptString"
    },
    {
      "description": "Firecrawl API Key (get from https://www.firecrawl.dev/app/api-keys)",
      "id": "firecrawl_api_key",
      "password": true,
      "type": "promptString"
    }
  ],
  "servers": {
    "agent-memory": {
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/agent-memory\" \"$@\"",
        "agent-memory",
        "mcp"
      ],
      "command": "/bin/sh",
      "type": "stdio"
    },
    "qartez": {
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/qartez\" \"$@\"",
        "qartez"
      ],
      "command": "/bin/sh",
      "type": "stdio"
    },
    "headroom": {
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/headroom\" \"$@\"",
        "headroom",
        "mcp",
        "serve",
        "--transport",
        "stdio"
      ],
      "command": "/bin/sh",
      "env": {},
      "type": "stdio"
    }
  }
}
