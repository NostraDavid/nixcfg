            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "command": "/nix/store/idnip77gy6jrib5cdqwijr12ravyf1rd-lean-ctx-3.9.12/bin/lean-ctx hook read-dedup",
            "type": "command"
          }
        ],
        "matcher": "Read"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "/nix/store/idnip77gy6jrib5cdqwijr12ravyf1rd-lean-ctx-3.9.12/bin/lean-ctx hook observe",
