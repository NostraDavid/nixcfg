          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "snip hook",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "/nix/store/idnip77gy6jrib5cdqwijr12ravyf1rd-lean-ctx-3.9.12/bin/lean-ctx hook rewrite",
            "type": "command"
          }
        ],
        "matcher": "Bash|bash"
      },
      {
        "hooks": [
          {
            "command": "/nix/store/idnip77gy6jrib5cdqwijr12ravyf1rd-lean-ctx-3.9.12/bin/lean-ctx hook redirect",
            "type": "command"
          }
        ],
        "matcher": "Read|read|ReadFile|read_file|View|view|Grep|grep|Search|search|ListFiles|list_files|ListDirectory|list_directory|Glob|glob"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/nix/store/idnip77gy6jrib5cdqwijr12ravyf1rd-lean-ctx-3.9.12/bin/lean-ctx hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/nix/store/idnip77gy6jrib5cdqwijr12ravyf1rd-lean-ctx-3.9.12/bin/lean-ctx hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/nix/store/idnip77gy6jrib5cdqwijr12ravyf1rd-lean-ctx-3.9.12/bin/lean-ctx hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/nix/store/idnip77gy6jrib5cdqwijr12ravyf1rd-lean-ctx-3.9.12/bin/lean-ctx hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
